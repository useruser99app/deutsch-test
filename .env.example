# NORAV V0.1 — Environment-Variablen
# Kopie als .env.local anlegen. NIEMALS echte Secrets committen.

# Supabase-Projekt (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Nur serverseitig! Niemals im Client-Bundle verwenden.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Basis-URL der App (für Auth-Redirects in E-Mail-Links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transaktions-E-Mail (optional). Ohne diese Werte laufen alle Abläufe
# unverändert weiter; Benachrichtigungen werden dann als "skipped" vermerkt
# statt versendet. Nur serverseitig, niemals mit NEXT_PUBLIC_ präfixen.
RESEND_API_KEY=your-resend-api-key
NORAV_EMAIL_FROM=NORAV <noreply@your-domain.example>

# ALLEMARO V0.1 — Environment-Variablen
# Kopie als .env.local anlegen. NIEMALS echte Secrets committen.

# ---------------------------------------------------------------------------
# Supabase-Projekt (Dashboard → Project Settings → API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Nur serverseitig! Niemals im Client-Bundle verwenden.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Basis-URL der App
#
# Daraus baut die Anwendung alle Einladungs-, Passwort-Reset- und
# Benachrichtigungslinks. Es ist eine reine Umgebungseinstellung, keine
# Konstante im Code — dieselbe Anwendung laeuft dadurch unveraendert lokal
# und in Produktion.
#
#   Entwicklung: http://localhost:3000
#   Produktion:  https://allemaro.com
#
# WICHTIG: Jeder Wert, der hier gesetzt wird, muss in Supabase unter
# Authentication → URL Configuration als erlaubte Redirect-URL hinterlegt
# sein, sonst lehnt Supabase den Auth-Link ab.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Transaktions-E-Mail (optional)
#
# Ohne diese Werte laufen alle Ablaeufe unveraendert weiter; Benachrichtigungen
# werden dann als "skipped" vermerkt statt versendet. Nur serverseitig,
# niemals mit NEXT_PUBLIC_ praefixen.
#
# Der Absender muss eine bei Resend verifizierte Domain verwenden. Der
# folgende Wert ist ein Beispiel — die Adresse ist NICHT eingerichtet und
# NICHT verifiziert; das geschieht erst bei der Domain-Verifizierung.
# ---------------------------------------------------------------------------
RESEND_API_KEY=your-resend-api-key
ALLEMARO_EMAIL_FROM=ALLEMARO <notifications@allemaro.com>

# Kompatibilitaet: Ist ALLEMARO_EMAIL_FROM nicht gesetzt, akzeptiert die
# Anwendung uebergangsweise weiterhin NORAV_EMAIL_FROM aus der Zeit vor dem
# Rebrand. Neue Umgebungen sollten ausschliesslich ALLEMARO_EMAIL_FROM
# setzen; die Ruecknahme des Fallbacks erfolgt, sobald alle Deployments
# umgestellt sind.
